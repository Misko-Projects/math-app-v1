{
  "name": "@number-island/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/db-migrate.mjs && wrangler dev --port 8787 --ip 127.0.0.1",
    "preview": "node scripts/db-migrate.mjs --env preview && wrangler dev --port 8787 --ip 127.0.0.1 --env preview",
    "preview:e2e": "node scripts/db-e2e.mjs && wrangler dev --port 8787 --ip 127.0.0.1 --env preview --persist-to .wrangler/e2e",
    "db:migrate":"node scripts/db-migrate.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "node scripts/db-seed.ts",
    "db:generate": "drizzle-kit generate",
    "ai:smoke": "node scripts/ai-smoke.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@number-island/engine": "workspace:*",
    "@number-island/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.164.0"
  }
}
