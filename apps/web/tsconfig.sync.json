{
  // The D01 sync integration tests (sync-test/), which run inside workerd through the Workers pool
  // (vitest.sync.config.ts) and import the web data layer.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "build/tsc/sync",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["sync-test", "src/data"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.test-support.ts"],
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/content" },
    { "path": "../../packages/engine" }
  ]
}
